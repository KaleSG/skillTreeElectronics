---
const { PageTitle, PageDescription, ...rest } = Astro.props;
import "@style/global.css";
import Navigator from "@components/ui/Navigator/Navigator.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Non-Interactive Metadata -->
    <meta name="robots" content="noindex,nofollow" />

    <!-- Page Configurations -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta charset="utf-8" />

    <!-- Page Info -->
    <title>{PageTitle} | skillTreeElectronics</title>
    <meta name="description" content={PageDescription} />
  </head>
  <body>
    <Navigator />

    <main>
      <slot />
    </main>
  </body>
</html>
<style>
  body {
    height: 100vh;
  }
  main {
    width: 100vw;
    padding-top: 2.8rem;
    display: flex;
    align-items: top;
    justify-content: center;
    overflow: hidden;
  }
</style>
