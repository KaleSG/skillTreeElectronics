---
import PageBase from "@components/pages/PageBase.astro";
import EmbeddedCanvas from "@components/ui/EmbeddedCanvas/EmbeddedCanvas.astro";
import "@style/global.css";

import "@ts/engine/content-processor.ts";
---

<PageBase PageTitle="Skill Tree">
  <div id="viewport">
    <EmbeddedCanvas>
      <div id="idk"></div>
    </EmbeddedCanvas>
  </div>
</PageBase>
<style>
  #viewport {
    width: calc(100vw - 2rem);
    margin-top: 1rem;
    height: 85vh;
    overflow: hidden;
    border: 2px solid var(--color-fg-muted-1-accented);
    border-radius: 1rem;
    box-shadow: 0px 0px 20px 1px
      color-mix(in srgb, var(--color-fg-base-accented) 20%, transparent);

    #idk {
      width: 50px;
      height: 50px;
      background-color: red;
    }
    #idk:active {
      background-color: blue;
    }
  }
</style>
