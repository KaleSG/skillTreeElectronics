{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@style/*": ["./src/style/*"],
      "@components/*": ["./src/components/*"],
      "@ts/*": ["./src/ts/*"],
      "@assets/*": ["./public/assets/*"],
      "@astro-icons/*": ["./public/assets/astro-svg/*"]
    }
  }
}
