---
import LeafChip from '../components/branding/logos/LeafChip.astro'
---

<nav>
  <LeafChip id="leaf-chip-logo" />
  <a href="/">SkillTree</a>
  <a href="/">About</a>
</nav>

<style>
  nav {
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  a {
    display: flex;
    text-align: center;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0.75rem;
    font-size: 1.1rem;
    font-color: var(--color-foreground);
    font-weight: bold;
    transition:
      transform 0.5s ease,
      background-color 0.5s ease,
      font-size 0.5s ease;
  }

  #leaf-chip-logo {
    height: 4rem;
    width: auto;
    margin: 1rem 0.5rem 0.5rem 1rem;
  }

  a:hover {
    background-color: var(--color-background-accent-hover);
    color: var(--color-accent-foreground);
  }

  a:active {
    background-color: var(--color-background-accent-active);
  }
  @media screen and (max-width: 1024px) {
    a {
      border-bottom: 1px solid var(--color-accent-dim);
    }
  }

  @media screen and (min-width: 1024px) {
    nav {
      flex-direction: row;
      justify-content: left;
      border-bottom: 1px solid var(--color-accent);
    }
    a {
      width: fit-content;
      padding: 0 1.2rem 0 1.2rem;
      font-size: 1rem;
      flex-grow: 0;
    }

    a:hover {
      font-size: 1.1rem;
    }

    #leaf-chip-logo {
      display: flex;
      height: 2.5em;
      margin: 0.7rem 0.5rem 0.7rem 0.5rem;
    }
  }
</style>
