---
import '../styles/global.css'
import LeafChip from '../components/branding/logos/LeafChip.astro'
---

<nav>
  <LeafChip id="leaf-chip-logo" />
  <a href="/"> SkillTr<span class="text-accent">EE</span></a>
  <a href="/">About</a>
  <a href="/">Contact</a>
</nav>

<style>
  nav {
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0px 0px 10px 10px var(--color-accent-dim);
  }

  a {
    display: flex;
    text-align: center;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0.75rem;
    font-color: var(--color-foreground);
    font-weight: bold;
    transition:
      transform 0.5s ease,
      background-color 0.5s ease,
      font-size 0.5s ease;
  }

  #leaf-chip-logo {
    padding: 0.5rem 0.5rem;
    width: auto;
    height: 8rem;
  }

  a:hover {
    background-color: var(--color-background-accent-hover);
    color: var(--color-accent-foreground);
  }

  a:active {
    background-color: var(--color-background-accent-active);
  }
  @media screen and (max-width: 1024px) {
  }

  @media screen and (min-width: 1024px) {
    nav {
      flex-direction: row;
      justify-content: left;

      height: 4rem;
      border-bottom: 1px solid var(--color-accent);
    }

    a {
      width: fit-content;
      padding: 0 2rem 0 2rem;
      font-size: 1rem;
      flex-grow: 0;
    }

    a:hover {
      font-size: 1.1rem;
    }

    #leaf-chip-logo {
      height: 100%;
    }
  }
</style>
