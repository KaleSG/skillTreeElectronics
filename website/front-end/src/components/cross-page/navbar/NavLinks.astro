---
import AboutMark from './icons/AboutMark.astro'
import NodeTree from './icons/NodeTree.astro'
import ToS from './icons/ToS.astro'
import '../../../styles/Navbar.css' /* Colors, styling, animation timing can all be found here. */
const { ...rest } = Astro.props
---

<div id="drop-down-links" {...rest}>
  <a class="link">
    <NodeTree class="link-icon" />
    Skill Tree
  </a>
  <a class="link">
    <AboutMark class="link-icon" />
    About
  </a>
  <a class="link">
    <ToS class="link-icon" />
    Terms of Use
  </a>
</div>

<style>
  * {
    display: flex;
  }
  #drop-down-links {
    width: 100%;
    overflow: hidden;
    height: fit-content;
    max-height: calc(var(--navbar-base-height) * 3);
    flex-direction: column;
    transition: var(--navbar-link-time) ease;
  }

  #drop-down-links > .link {
    display: flex;
    height: var(--navbar-base-height);
    fill: var(--navling-fill-color);
    align-items: center;
    font-weight: bold;
    background-color: var(--navlink-background-color);
    border-bottom: 1px solid var(--navlink-accent-color);

    padding: var(--navbar-padding);

    transition:
      background-color var(--navbar-link-time) ease,
      color var(--navbar-link-time) ease,
      fill var(--navbar-link-time) ease;
  }

  #drop-down-links > .link:hover {
    background-color: var(--navlink-hover-bg-color);
    color: var(--navbar-button-hover-fill);
    fill: var(--navbar-button-hover-fill);
    cursor: pointer;
  }

  #drop-down-links > .link:active {
    fill: var(--navbar-button-active-fill);
    color: var(--navbar-button-active-fill);

    transition:
      background-color var(--navbar-button-click-transition-time) ease,
      color var(--navbar-button-click-transition-time) ease,
      fill var(--navbar-button-click-transition-time) ease;
  }

  #drop-down-links > .link > .link-icon {
    width: fit-content;
    height: 100%;
    margin-left: 0.1rem;
    margin-right: 0.6rem;
    padding: 0.1rem;
  }
</style>
