---
import '@style/global.css'
import UniversalMetadata from '@components/cross-page/UniversalMetadata.astro'
import Navbar from '@components/navbar/Navbar.astro';
import '@style/Navbar.css' /* Colors, styling, animation timing can all be found here. */

const {PageTitle, ...rest} = Astro.props;
---
<html lang="en">
  <head>
    <UniversalMetadata />

    <!-- Basic Page Information -->
    <meta charset="utf-8" />
    <title>{PageTitle} | skillTreeElectronics</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      
    <!-- Pinch-Zoom Prevention on Main SkillTree page -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  </head>

  <body>
    <div id="page-container">
      <Navbar />
      <main id="content-container" {...rest}>
        <slot />
      </main>
    </div>
    
  </body>
</html>
<style>
  * {
    display: flex;
  }

  #page-container {
    flex-direction: column;
    height: 100vh;
    width: 100vw;
  }

  #page-container>#content-container {
    margin-top: var(--navbar-base-height);
    width: 100vw;
    flex-grow: 1;
  }
</style>
