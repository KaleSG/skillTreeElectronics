---
import '../../styles/global.css'
import Page from './Page.astro';
import '../../styles/markdown-styling/singleMarkDown.css'

const {PageTitle} = Astro.props
---

<Page id="content-container" PageTitle={PageTitle}>
  <!-- Wrap in a styled container -->
  <article id="main-conent-column">
     <span id="copyright-notice">© 2026 skillTreeElectronics. All rights reserved.</span>
    <slot></slot>
  </article>
</Page>
<style>

  #copyright-notice {
    color: var(--color-foreground-5);
    font-size: 0.8rem;
    margin: 0;
    padding: 0;
  }
  #content-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    overflow: hidden;
  }

  #content-container>#main-conent-column {
    background-color: var(--color-dark-2);
    width: 100%;
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin: 0.5rem;
    overflow: scroll;
    box-shadow: 0px 0px 1px 1px color-mix(in srgb, var(--color-accent-green) 20%,transparent);
    z-index:100;
  }

   @media screen and (min-width: 1024px) {
    #content-container>#main-conent-column {
    width: 80%;
    }
  }

  @media screen and (min-width: 1200px) {
    #content-container>#main-conent-column {
    width: 60%;
    }
  }

</style>