---
import '@style/global.css'
import Page from '@components/template/Page.astro'
import NodeTree from '@components/navbar/icons/NodeTree.astro'
import CanvasViewport from '@components/canvas-viewport/CanvasViewport.astro'
---

<Page PageTitle="Skill Tree" id="content-container">
  <div id="skill-tree-viewport">
    
    <div id="page-title-card">
      <NodeTree id="node-tree-icon" />
      <span>Skill Tree</span>
    </div>

    <CanvasViewport>
      <div style="height:20px; width: 20px; background-color: red;"></div>
    </CanvasViewport>

  </div>
</Page>
<style>
   #skill-tree-viewport {
    position: relative;
    height: 95%;
    border-radius: 20px;
    border: 2px solid color-mix(in srgb, var(--color-foreground-0) 40%, transparent);
    width: 98%;
    margin: auto;
    overflow: hidden;

  }

  /* Skill Tree Title Card Styling */
  #page-title-card {
    position: absolute;
    left: 1rem;
    top: 0.7rem;
    --title-card-color: color-mix(in srgb, var(--color-foreground-0) 70%, transparent);
    display: flex;
    align-items: center;
    font-weight: 600;
    color: var(--title-card-color);
    fill: var(--title-card-color);

    z-index: 1000;
  }

  #page-title-card > #node-tree-icon {
    width: 2.5rem;
    height: 2.5rem;
    margin-right: 1rem;
  }

</style>